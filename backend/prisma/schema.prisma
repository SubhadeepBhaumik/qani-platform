generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          String   // admin, recruiter, candidate
  companyName   String?
  companyId     String?
  phone         String?
  location      String?
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model Job {
  id                  String   @id @default(cuid())
  recruiterId         String?
  company             String?
  title               String
  department          String?
  category            String?
  location            String
  employmentType      String[] 
  salaryMin           Int?
  salaryMax           Int?
  description         String?
  requirementsMust    String[]
  requirementsNice    String[]
  skillsRequired      String[]
  experienceLevel     String?
  experienceYearsMin  Int?
  experienceYearsMax  Int?
  screeningQuestions  String[]
  mandatoryQuestions  Json     @default("{}")
  qualificationWeights Json?
  status              String   @default("open")
  expiresAt           DateTime?
  postedDate          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  applications        Application[]

  @@map("jobs")
}

model Application {
  id                   String   @id @default(cuid())
  candidateId          String
  candidateName        String?
  candidateEmail       String?
  jobId                String?
  jobTitle             String?
  company              String?
  status               String   @default("applied")
  aiScore              Int?
  scoreBreakdown       Json?
  scorecard            Json?
  aiFeedback           String?
  recruiterNotes       String?
  notes                Json     @default("[]")
  cvUrl                String?
  appliedDate          DateTime?
  appliedAt            DateTime @default(now())
  screeningStartedAt   DateTime?
  screeningCompletedAt DateTime?
  screeningSessionId   String?
  interviewDateTime    DateTime?
  updatedAt            DateTime @updatedAt

  job                  Job?     @relation(fields: [jobId], references: [id])
  screeningSessions    ScreeningSession[]

  @@map("applications")
}

model ScreeningSession {
  id               String   @id @default(cuid())
  applicationId    String
  status           String   @default("active")
  messages         Json     @default("[]")
  currentQuestionIdx Int    @default(0)
  totalQuestions   Int      @default(0)
  mandatoryCount   Int      @default(0)
  jobData          Json?
  startDate        DateTime @default(now())
  score            Int?
  decision         String?
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  application      Application @relation(fields: [applicationId], references: [id])

  @@map("screening_sessions")
}

model Notification {
  id                   String   @id @default(cuid())
  recipientId          String?
  recipientEmail       String?
  type                 String
  title                String
  message              String?
  status               String   @default("unread")
  relatedJobId         String?
  relatedApplicationId String?
  interviewDateTime    DateTime?
  createdAt            DateTime @default(now())

  @@map("notifications")
}

model CandidateProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  bio               String?
  skills            String[]
  linkedinUrl       String?
  githubUrl         String?
  cvUrl             String?
  cvFilename        String?
  workRights        String?
  salaryExpectation Int?
  availableFrom     DateTime?
  phone             String?
  location          String?
  profilePhotoUrl   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("candidate_profiles")
}

model TeamMember {
  id          String   @id @default(cuid())
  companyId   String?
  email       String
  role        String
  invitedBy   String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@map("team_members")
}
